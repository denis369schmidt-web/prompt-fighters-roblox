--!strict
-- Keyword data for prompt fighters (Prompt/Interpreter): elements, body types, weapons and tempo words in German
-- and English, plus everything each one means for a fighter (palette, gear, base kit, stat leanings, names).
--
-- THE ORDER OF EVERY LIST IS PART OF THE PROMPT CODE FORMAT (Prompt/Code stores list indices). Only append new
-- entries at the end; never reorder, remove or insert, or every shared code changes its fighter.
--
-- Stat deltas are { vitality, power, defense, speed, technique }. Kits and signature donors are roster fighter
-- ids (Data/Generated/*); a prompt fighter borrows their moves, physics and signature mechanic.

export type StatDelta = { number }

export type Element = {
	key: string,
	words: { string },
	name: string, -- name prefix: EIS + GOLEM = EISGOLEM
	sig: string, -- signature name prefix: Frost + meteor = Frostmeteor
	adjective: string, -- title: "Eisiger Koloss"
	label: string, -- shown as the element (Roster.elementLabel)
	element: string, -- game element id (Visuals.elementColor, effects)
	glow: string,
	primary: string,
	secondary: string,
	accent: string,
	hair: string,
	material: string?, -- clothing material
	rock: string?, -- material for stone/rock bodies (golem) of this element
	magic: boolean?, -- glowing eyes
	stats: StatDelta,
	signatures: { string }, -- roster fighters whose signature mechanic fits
	extraGear: string?, -- element accessory added when there is room
	extraSlot: string?, -- what the accessory occupies (skipped if the body already uses that slot)
}

export type Body = {
	key: string,
	words: { string },
	name: string, -- name part as main body: GOLEM
	prefix: string, -- name part as second body: ROBO + SAMURAI
	role: string, -- title noun: "Koloss"
	archetype: string,
	kit: string, -- roster fighter whose moves and physics the body borrows
	build: string,
	scale: { number }, -- height, width, depth, head
	gear: { string }, -- most important first: over the part budget, gear from the end is left off
	weapon: number?, -- default weapon index (Keywords.WEAPONS) when the prompt names none
	trait: string?, -- gear this body adds when it is the second body ("Roboter Samurai")
	traitSlot: string?, -- what the trait occupies (skipped if the main body already uses that slot)
	slots: { string }, -- slots the main body's gear already occupies: head, back, tail, cape, hands
	skin: string?, -- "rock" | "metal" | "bone" | "pale" | "fur" | "tint" | nil (human tones)
	face: { [string]: any }?,
	headOffset: { number }?,
	stats: StatDelta, -- base stats, sum 100
	element: string?, -- element key implied when the prompt names none (Roboter -> Metall)
	look: { [string]: any }?, -- extra Look fields
}

export type Weapon = {
	key: string,
	words: { string },
	name: string, -- name part when the prompt names no body: FEUER + HAMMER
	gear: { string },
	stats: StatDelta,
	hands: boolean?, -- replaces the body's fist gear
}

export type Tempo = { key: string, words: { string }, adjective: string, stats: StatDelta, run: number, build: string? }

