local Knockback = require(Shared.Combat.Knockback)

describe("Knockback.compute", function()
	it("matches the Godot formula for a light hit at 0 %", function()
		local hit = Knockback.compute(10, 1.0, 0, 14, 0.88, 1)
		expect(hit.damage).toBeCloseTo(8.6, 4)
		expect(hit.percent).toBeCloseTo(8.6, 4)
		expect(hit.vx).toBeCloseTo(4.5503, 3)
		expect(hit.vy).toBeCloseTo(2.6766, 3)
		expect(hit.hitstun).toBeCloseTo(0.3172, 4)
		expect(hit.airControlLock).toBeCloseTo(0.3172 * 0.6, 4)
	end)

	it("clamps defense to 0.90 and weight to 1.35 and launches left", function()
		local hit = Knockback.compute(20, 2.0, 150, 5, 1.6, -1)
		expect(hit.damage).toBeCloseTo(18, 4)
		expect(hit.percent).toBeCloseTo(168, 4)
		expect(hit.vx).toBeCloseTo(-22.6297, 3)
		expect(hit.vy).toBeCloseTo(13.3116, 3)
		expect(hit.hitstun).toBeCloseTo(0.636, 4)
	end)

	it("never lets the defense multiplier drop below 0.55", function()
		expect(Knockback.defenseMult(80)).toBe(0.55)
	end)

	it("keeps a minimum upward launch of 1.8 m/s", function()
		expect(Knockback.compute(1, 0.01, 0, 20, 1, 1).vy).toBe(1.8)
	end)

	it("caps percent at 999", function()
		expect(Knockback.compute(50, 1, 990, 10, 1, 1).percent).toBe(999)
	end)

	it("launches further at higher percent", function()
		local low = Knockback.compute(10, 1, 20, 15, 1, 1)
		local high = Knockback.compute(10, 1, 120, 15, 1, 1)
		expect(high.vx).toBeGreaterThan(low.vx)
	end)

	it("throws forward with the Godot throw curve", function()
		local hit = Knockback.throw("forward", 50, 20, 1.0, 20, 1)
		expect(hit.damage).toBeCloseTo(13.2, 4)
		expect(hit.vx).toBeCloseTo(5.7837, 3)
		expect(hit.vy).toBeCloseTo(2.2528, 3)
	end)

	it("throws back against the facing direction", function()
		expect(Knockback.throw("back", 0, 10, 1, 20, 1).vx).toBeLessThan(0)
	end)
end)
